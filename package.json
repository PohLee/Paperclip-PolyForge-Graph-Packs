{
  "name": "@paperclip-polyforge/packs",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./adlc": "./packs/adlc/index.mjs",
    "./marketing": "./packs/marketing/index.mjs",
    "./creative-team": "./packs/adlc-creative-team/index.mjs",
    "./catalog": "./catalog.mjs"
  },
  "files": [
    "index.mjs",
    "catalog.mjs",
    "README.md",
    "LICENSE",
    "docs/**",
    "scripts/**",
    "dist/adlc/**",
    "dist/marketing/**",
    "dist/creative-team/**",
    "packs/adlc/**",
    "packs/marketing/**",
    "packs/adlc-creative-team/index.mjs",
    "packs/adlc-creative-team/README.md",
    "packs/adlc-creative-team/THIRD_PARTY_NOTICES.md",
    "packs/adlc-creative-team/package.json",
    "packs/adlc-creative-team/adapters/**",
    "packs/adlc-creative-team/contracts/**",
    "packs/adlc-creative-team/docs/**",
    "packs/adlc-creative-team/graphs/**",
    "packs/adlc-creative-team/policies/**",
    "packs/adlc-creative-team/roles/**",
    "packs/adlc-creative-team/runtime/**",
    "packs/adlc-creative-team/scripts/**",
    "packs/adlc-creative-team/skills/**",
    "packs/adlc-creative-team/templates/**",
    "packs/adlc-creative-team/sources/brand-methods.json",
    "packs/adlc-creative-team/sources/README.md",
    "packs/adlc-creative-team/sources/references.json",
    "packs/adlc-creative-team/sources/licenses/**"
  ],
  "scripts": {
    "build:roles": "node packs/adlc/scripts/build-roles.mjs && node packs/marketing/scripts/build-roles.mjs",
    "build:adlc": "node scripts/build-pack.mjs adlc",
    "build:marketing": "node scripts/build-pack.mjs marketing",
    "build:creative-team": "node scripts/build-pack.mjs creative-team",
    "release:adlc": "node scripts/tag-pack.mjs adlc",
    "release:marketing": "node scripts/tag-pack.mjs marketing",
    "release:creative-team": "node scripts/tag-pack.mjs creative-team",
    "test:root": "node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs packs/adlc-creative-team/tests/*.test.mjs packs/adlc-creative-team/tests/skills/*.test.mjs packs/adlc-creative-team/tests/source/*.test.mjs",
    "test:full-suite": "node --test test/*.test.mjs packs/adlc-creative-team/tests/*.test.mjs packs/adlc-creative-team/tests/skills/*.test.mjs packs/adlc-creative-team/tests/source/*.test.mjs"
  }
}
